#!/usr/bin/env node
// PreToolUse hook (Edit|Write|MultiEdit|NotebookEdit). Asks before an edit:
// - adds a test-skip marker to a test file;
// - touches the active approved spec.md (newest task folder under
//   $HOME/.claude/specs/<git root name>/ whose spec.md says "Status: APPROVED");
// - touches a file named in that spec's acceptance commands that exists at
//   HEAD. Untracked files are not protected: the implementer may have to
//   write them.
'use strict';

const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const { spawnSync } = require('node:child_process');

const MARKERS = [
  '.skip(', 'xit(', 'xdescribe(', 'xtest(',
  '@pytest.mark.skip', '@pytest.mark.xfail', '@unittest.skip',
  't.Skip(', '#[ignore]', '@Disabled', 'Skip =', '[Ignore]',
];

function isTestFile(file) {
  const base = path.basename(file);
  if (/\.(test|spec)\./.test(base) || /_test\./.test(base) || /^test_.*\.(py|ipynb)$/.test(base)) return true;
  return file.split(/[\\/]/).slice(0, -1).some((dir) => ['test', 'tests', '__tests__'].includes(dir));
}

function readOr(file, fallback) {
  try { return fs.readFileSync(file, 'utf8'); } catch { return fallback; }
}

// Real path of a file that may not exist yet (resolve its parent instead).
function real(p) {
  try { return fs.realpathSync(p); } catch {}
  try { return path.join(fs.realpathSync(path.dirname(p)), path.basename(p)); } catch {}
  return p;
}

function pairs(tool, input, file) {
  if (tool === 'Edit') return [[input.old_string || '', input.new_string || '']];
  if (tool === 'MultiEdit') {
    return (input.edits || []).map((e) => [e.old_string || '', e.new_string || '']);
  }
  // Write and NotebookEdit: compare against the whole current file, read only
  // when the new content could trigger.
  const content = tool === 'Write' ? input.content : tool === 'NotebookEdit' ? input.new_source : null;
  if (typeof content !== 'string' || !MARKERS.some((m) => content.includes(m))) return [];
  return [[readOr(file, ''), content]];
}

function gitRoot(dir) {
  for (let d = dir; ; d = path.dirname(d)) {
    if (fs.existsSync(path.join(d, '.git'))) return d;
    if (path.dirname(d) === d) return null;
  }
}

// spec.md path of the newest task folder whose spec is approved, or null.
function activeSpec(root) {
  const base = path.join(os.homedir(), '.claude', 'specs', path.basename(root));
  let dirs;
  try {
    dirs = fs.readdirSync(base, { withFileTypes: true }).filter((e) => e.isDirectory())
      .map((e) => {
        const p = path.join(base, e.name);
        return { p, t: fs.statSync(p).mtimeMs };
      })
      .sort((a, b) => b.t - a.t);
  } catch {
    return null;
  }
  for (const { p } of dirs) {
    const spec = path.join(p, 'spec.md');
    const text = readOr(spec, null);
    if (text !== null && /^Status: APPROVED/m.test(text)) return { spec, text };
  }
  return null;
}

// Lines of the first ```bash block under "## Acceptance commands".
function acceptanceLines(text) {
  const m = /^## Acceptance commands[^\n]*\n([\s\S]*?)(?=^## |$(?![\s\S]))/m.exec(text);
  if (!m) return [];
  const block = /^```bash[^\n]*\n([\s\S]*?)^```/m.exec(m[1]);
  return block ? block[1].split('\n').filter((l) => l.trim() && !l.trim().startsWith('#')) : [];
}

function protectedReason(file, cwd) {
  const root = gitRoot(cwd);
  if (!root) return null;
  const active = activeSpec(root);
  if (!active) return null;
  if (real(file) === real(active.spec)) {
    return `This edit changes the approved spec ${active.spec} (rule: approved spec). Confirm that changing the spec is intended.`;
  }
  const rootReal = real(root);
  const target = real(file);
  if (!target.startsWith(rootReal + path.sep)) return null;
  for (const line of acceptanceLines(active.text)) {
    for (const raw of line.split(/[\s;&|<>()]+/)) {
      const tok = raw.replace(/^['"]|['"]$/g, '');
      if (!tok || tok.startsWith('-')) continue;
      if (real(path.resolve(root, tok)) !== target) continue;
      const rel = path.relative(rootReal, target).split(path.sep).join('/');
      const res = spawnSync('git', ['cat-file', '-e', `HEAD:${rel}`], { cwd: root, stdio: 'ignore' });
      if (res.status !== 0) return null;
      return `This edit changes ${rel}, a tracked file used by the acceptance commands of the approved spec ${active.spec} (rule: acceptance file). Confirm that changing it is intended.`;
    }
  }
  return null;
}

function ask(reason) {
  process.stdout.write(JSON.stringify({
    hookSpecificOutput: {
      hookEventName: 'PreToolUse',
      permissionDecision: 'ask',
      permissionDecisionReason: reason,
    },
  }) + '\n');
}

function main() {
  let event;
  try {
    event = JSON.parse(fs.readFileSync(0, 'utf8'));
  } catch {
    return;
  }
  if (!event || typeof event !== 'object') return;
  const tool = event.tool_name;
  const input = event.tool_input || {};
  const name = tool === 'NotebookEdit' ? input.notebook_path : input.file_path;
  if (typeof name !== 'string' || !name) return;
  const cwd = typeof event.cwd === 'string' && event.cwd ? event.cwd : process.cwd();
  const file = path.resolve(cwd, name);

  if (isTestFile(name)) {
    for (const [oldText, newText] of pairs(tool, input, file)) {
      const marker = MARKERS.find((m) => newText.includes(m) && !oldText.includes(m));
      if (marker) {
        ask(`This ${tool} adds the test-skip marker "${marker}" to ${name} (rule: test skip). Confirm that skipping or disabling this test is intended.`);
        return;
      }
    }
  }

  let reason = null;
  try { reason = protectedReason(file, cwd); } catch {}
  if (reason) ask(reason);
}

main();
